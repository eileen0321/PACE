<?xml version="1.0" encoding="utf-8"?>
<!-- 즐겨찾기 행의 공유 아이콘.
     2026-08-09 ① 사장님 지적("공유아이콘이 안드로이드 공식이야? 왜 공유로 인식이 안되지") —
       예전엔 유니코드 문자 `⇪`(U+21EA, 키보드 Caps Lock 화살표)를 TextView로 그렸다. 공유가 아니라
       "위로 올리기" 화살표라 아무도 공유로 못 읽는다.
     2026-08-09 ② 사장님 지적("공유 아이콘 애플처럼 만들어 니껀 너무 투박해 보이잔아") —
       ①의 처치로 Material `share`(점 3개를 두 선으로 이은 **채움** 도형)를 넣었는데, 작은 크기에서
       덩어리져 보여 패널의 얇은 선 톤과 안 맞았다.
       → iOS(SF Symbols `square.and.arrow.up`)와 같은 구성으로 다시 그린다: **위가 열린 상자 + 그
         위로 솟는 화살표**, 전부 **얇은 스트로크**(채움 없음)라 훨씬 가볍다.
       ⚠️ 이 모양은 iOS 관용구지만 안드로이드에서도 "공유"로 널리 통용된다(유튜브/삼성 등 다수 앱이
         변형해 쓴다). ①의 요구("공유로 읽혀야 한다")는 그대로 만족한다.
     stroke 기반이라 fillColor는 쓰지 않는다 — 색은 strokeColor 하나로만 정한다. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <!-- 위가 열린 상자 -->
  <path
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="1.7"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      android:pathData="M8.2,10.2 H6.6 C5.6,10.2 4.8,11 4.8,12 V18.4 C4.8,19.4 5.6,20.2 6.6,20.2 H17.4 C18.4,20.2 19.2,19.4 19.2,18.4 V12 C19.2,11 18.4,10.2 17.4,10.2 H15.8" />
  <!-- 화살표 몸통 -->
  <path
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="1.7"
      android:strokeLineCap="round"
      android:pathData="M12,3.6 V14.4" />
  <!-- 화살촉 -->
  <path
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="1.7"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      android:pathData="M8.6,7 L12,3.6 L15.4,7" />
</vector>
