<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- 2026-08-02 사장님 실기기 지적("광고 보고 5분 더인데 왜 광고 전에 오버레이 하단이 흰 키가 되고") —
       재발이다. 지난번엔 PaceRewardedAdActivity.onCreate()에서 window.statusBarColor/navigationBarColor를
       직접 지정하는 방식으로 고쳤는데, 그건 원인을 못 짚은 수정이었다: 액티비티 창의 "첫 프레임"은
       onCreate 코드가 아니라 테마(android:theme)가 그린다. 그래서 코드로 색을 바꾸기 전 한 프레임 동안
       @android:style/Theme.Translucent.NoTitleBar의 기본값(=OEM 밝은 시스템 바, 삼성 One UI에서는 흰
       내비게이션 키)이 그대로 노출됐다 — 사장님이 보시는 "잠깐 하얘지는" 그 순간이다.
       테마 자체에 어두운 시스템 바를 박아 첫 프레임부터 앱과 동일하게 만든다.

       ⚠️ 이 파일이 android/app/src/main/res가 아니라 모듈 쪽에 있는 이유: android/ 디렉터리는
       `npx expo prebuild`가 통째로 재생성하면서 수동 편집을 조용히 날린다(오늘 실제로 versionCode·
       AdActivity 테마·MainActivity 시스템바 코드가 이 방식으로 사라진 적이 있다). 모듈의 res/manifest는
       Gradle 병합으로 합쳐지므로 prebuild와 무관하게 살아남는다. 같은 이유로 PaceRewardedAdActivity의
       activity 선언도 모듈 AndroidManifest.xml로 옮겼다. -->
  <style name="Theme.Pace.TransparentAd" parent="@android:style/Theme.Translucent.NoTitleBar">
    <!-- ⚠️ 2026-08-05 사장님 재보고("보상형 광고 시작 전에 하단 흰 키, 광고에서는 검은 하단키") —
         아래 statusBarColor/navigationBarColor가 **무시되고 있었다.** 부모인 @android:style/
         Theme.Translucent(.NoTitleBar)는 머티리얼 이전 테마라 windowDrawsSystemBarBackgrounds가
         기본 false인데, 그러면 시스템이 창의 시스템 바 색 지정을 아예 안 쓴다(OEM 기본 = 흰 키).
         같은 원인을 아래 Theme.Pace.AdActivity에서는 이미 이 한 줄로 고쳐놨는데 **이쪽 테마에만
         빠뜨렸다** — 그래서 광고 액티비티(검정)로 넘어가는 순간 색이 바뀌는 것처럼 보였다.
         코드(PaceRewardedAdActivity.onCreate의 window.navigationBarColor)로도 같은 값을 넣지만
         그건 첫 프레임 이후라, 번쩍임을 없애려면 테마에서 처음부터 적용돼야 한다. -->
    <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    <!-- MainActivity/AppTheme와 동일한 색 — 이 모듈에서는 앱의 R.color를 참조할 수 없어 값으로 직접 지정. -->
    <item name="android:statusBarColor">#060709</item>
    <item name="android:navigationBarColor">#060709</item>
    <!-- 어두운 배경이므로 아이콘/키는 밝게(=light 모드 끄기). 이걸 안 끄면 어두운 배경 위에
         어두운 아이콘이 올라가 사실상 안 보인다. -->
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
    <!-- One UI가 투명/반투명 시스템 바 뒤에 자동으로 밝은 대비 배경(스크림)을 깔아 흰 키처럼 보이게
         만드는 동작을 끈다(Q+). 코드 쪽 isNavigationBarContrastEnforced와 같은 목적이되 첫 프레임부터 적용. -->
    <item name="android:enforceNavigationBarContrast">false</item>
    <item name="android:enforceStatusBarContrast">false</item>
    <!-- 화면을 그리지 않는 껍데기 액티비티이므로 배경은 완전 투명(뒤의 유튜브가 그대로 비쳐야 함),
         전환 애니메이션도 없어야 "쇼츠 위에 광고만 떴다 사라진" 느낌이 된다. -->
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowAnimationStyle">@null</item>
  </style>

  <!-- 2026-08-04 사장님 지적("광고 보면 화면이 까매진다") 전수 조사에서 확정한 원인 —
       구글 광고 SDK는 자기 매니페스트에서 AdActivity를 **투명 테마**로 선언한다
       (play-services-ads-lite AAR에서 직접 확인: android:theme="@android:style/Theme.Translucent").
       그런데 앱 매니페스트가 tools:replace로 이걸 @style/AppTheme(불투명, windowBackground=#060709)로
       바꿔놓고 있었다. 하단키 흰색을 잡으려던 수정이었는데 부작용이 정확히 "까만 화면"이다:
         1. 광고 콘텐츠가 아직/이미 안 그려진 순간(로드·전환·엔드카드 사이)에 뒤가 비치는 대신
            앱 배경색(#060709 ≈ 검정)이 화면을 꽉 채운다 — 사장님이 보시는 그 검은 화면.
         2. 투명 액티비티는 뒤 액티비티를 paused-but-visible로 남기는데(구글이 투명을 쓰는 이유),
            불투명으로 바꾸면 유튜브가 onStop까지 내려가 비디오 서피스가 파괴된다 → 광고를 닫고
            돌아오면 재생 UI·진행바는 정상인데 영상만 검게 나온다("유튜브를 죽이면 복구"의 정체).
         3. PaceRewardedAdActivity는 noHistory=true다. noHistory는 "안 보이게 되면 finish"라
            광고가 투명일 때는 안 걸리지만 불투명이 되는 순간 광고 재생 중에 껍데기가 finish된다
            → 광고가 닫힐 때 빈 태스크가 잠깐 검게 뜨고 복귀 전환과 겹친다.
       그래서 테마를 SDK 원래대로 투명으로 되돌리되, 원래 고치려던 시스템 바 문제는 위
       Theme.Pace.TransparentAd와 동일한 방식(테마에 색을 박아 첫 프레임부터 적용)으로 해결한다.

       ⚠️ 이 스타일을 앱이 아니라 모듈 res에 두는 이유는 위 Theme.Pace.TransparentAd와 같다 —
       android/는 prebuild가 재생성하며 수동 편집을 날린다. 설령 앱 매니페스트의 tools:replace 한
       줄이 그렇게 날아가더라도 이제는 안전하다: 그러면 SDK 기본값(=투명)으로 돌아갈 뿐이고,
       되돌아오는 건 흰 하단키라는 외관 문제뿐 검은 화면이 아니다. -->
  <style name="Theme.Pace.AdActivity" parent="@android:style/Theme.Translucent">
    <!-- 2026-08-04 실기기 확인 — 이 한 줄이 없으면 아래 statusBarColor/navigationBarColor가 **무시된다.**
         @android:style/Theme.Translucent는 머티리얼 이전 테마라 windowDrawsSystemBarBackgrounds가
         기본 false인데, 그 플래그가 꺼져 있으면 창이 시스템 바 영역을 그리지 않아 색 지정이 효력이 없다
         (실기기에서 광고 엔드카드 위 하단키가 흰색으로 나오는 걸로 확인). 투명도와는 무관한 플래그라
         켜도 windowIsTranslucent=true는 그대로 유지된다. -->
    <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    <!-- ⚠️ 2026-08-05 사장님 지적("광고색은 회색인데 키만 검은색이잖아") — 여기 색을 #060709로 박아뒀던
         게 잘못이었다. 이 창에 그려지는 건 **구글 광고 콘텐츠**이고 그 배경색은 광고마다 다르다
         (이번엔 회색). 우리가 하단에 검은 띠를 강제로 칠하니 광고와 어긋나 "키만 검은색"으로 보인다.
         광고 배경색은 알 수 없으므로 **맞출 수 없다 — 칠하지 않는 게 답이다.** 투명으로 두면 광고가
         그 영역까지 그대로 채운다.
         ⚠️ 투명으로 두되 enforce*Contrast=false는 반드시 유지해야 한다. One UI는 투명 시스템 바 뒤에
         자동으로 밝은 대비 스크림을 깔아 흰 키처럼 보이게 만드는데(원래 문제의 원인), 그걸 끄는 게
         이 두 줄이다. windowDrawsSystemBarBackgrounds도 유지 — 이게 꺼져 있으면 아래 색 지정 자체가
         무시돼 OEM 기본값(흰 키)으로 되돌아간다. -->
    <!-- ⚠️ 2026-08-05 (웹서치 후 정정) — 이 앱은 targetSdk 36이다. Android 15(SDK 35)+를 타겟하면
         시스템이 **강제 edge-to-edge**를 적용하고, 그 모드에서는 statusBarColor/navigationBarColor
         지정이 **무시된다.** 즉 위에서 색을 뭘로 넣든(검정이든 투명이든) 효력이 없었다 —
         오늘 이 파일에서 색만 바꾸며 시도한 것들이 전부 헛수고였던 이유다.
         회색 광고 아래 검은 띠의 정체는 "우리가 칠한 색"이 아니라 **광고가 안 그리는 영역에 그 뒤
         (투명 껍데기 → 유튜브)가 비치는 것**이다.
         → 이 창에 한해 강제 edge-to-edge를 끈다(공식 속성 windowOptOutEdgeToEdgeEnforcement, API 35+).
           그러면 광고가 시스템 바를 침범하지 않고 그 위에 정상 배치되고, 아래 색 지정도 다시 효력을 갖는다.
           translucent 계열도 함께 꺼야 한다(같은 증상의 알려진 처방 — SDK 35 타겟 시 광고가 내비게이션
           바와 겹치는 문제 보고 다수).
         ⚠️ 구버전 안드로이드는 모르는 속성이라 그냥 무시한다(이 기기는 Android 13이라 원래 이 문제 없음). -->
    <!-- ⚠️ 2026-08-05 (2차 정정) — 직전 수정에서 windowOptOutEdgeToEdgeEnforcement + translucent=false를
         넣었는데 **방향이 반대였다.** 실기기 확인 결과 하단이 여전히 검었다.
         두 가지를 놓쳤다:
          1) 이 기기는 Android 13(SDK 33)이다. 강제 edge-to-edge는 **Android 15+에서만** 적용되므로
             이 기기엔 애초에 해당이 없었고, navigationBarColor는 정상으로 먹고 있었다
             (= 검은 띠는 우리가 칠한 것이 맞다).
          2) translucent=false로 두면 **광고가 시스템 바 영역을 아예 못 그린다.** 그러면 그 띠는
             광고와 무관한 색으로 남을 수밖에 없다 — 광고 배경색은 광고마다 달라 맞출 방법이 없다.
         → 방향을 반대로 잡는다: **광고가 시스템 바 아래까지 그리게 두고(translucent=true), 우리는
           아무 색도 칠하지 않는다(transparent).** 그러면 회색 광고면 회색이 그대로 이어진다.
         ⚠️ enforce*Contrast=false는 반드시 유지 — One UI가 투명 바 뒤에 밝은 스크림을 깔아
           "흰 키"로 보이게 만드는 동작을 끄는 것이 이 두 줄이다(원래 이 사태의 출발점). -->
    <item name="android:windowTranslucentStatus">true</item>
    <item name="android:windowTranslucentNavigation">true</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
    <item name="android:enforceNavigationBarContrast">false</item>
    <item name="android:enforceStatusBarContrast">false</item>
  </style>
  <!-- 2026-08-05 — 화면을 안 그리는 투명 껍데기 액티비티 공용 테마(PaceShareCaptureActivity).
       ⚠️ windowDrawsSystemBarBackgrounds가 없으면 시스템 바 색 지정이 무시돼 OEM 기본(흰 키)이
       그대로 나온다 — Theme.Pace.TransparentAd에서 겪은 것과 완전히 같은 함정이다.
       매니페스트에서 @android:style/Theme.Translucent.NoTitleBar를 직접 쓰면 이 보호가 없다. -->
  <style name="Theme.Pace.TransparentShell" parent="@android:style/Theme.Translucent.NoTitleBar">
    <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    <item name="android:statusBarColor">#060709</item>
    <item name="android:navigationBarColor">#060709</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
    <item name="android:enforceNavigationBarContrast">false</item>
    <item name="android:enforceStatusBarContrast">false</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowAnimationStyle">@null</item>
  </style>
</resources>
