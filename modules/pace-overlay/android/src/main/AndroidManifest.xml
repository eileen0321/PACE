<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- 이 모듈의 매니페스트는 Gradle 매니페스트 병합으로 앱 최종 AndroidManifest.xml에 자동 합쳐진다
       (Expo Modules API 로컬 모듈 컨벤션) — 별도 config plugin으로 권한을 추가할 필요 없음. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- PaceTickReceiver가 Doze 중 알람 처리 동안 짧게(최대 10초) CPU를 붙잡아두는 데 필요 -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- 포그라운드 앱 감지(ForegroundAppWatcher, UsageStatsManager)용 — 런타임 권한이 아니라
       설정 > 특별 앱 액세스 > 사용정보 접근에서 사용자가 직접 승인해야 하는 특수 권한 -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
  <!-- 2026-07-29 사장님 결정 — 핑거스냅(PaceSnapDetector)이 iOS/Android 둘 다 완전히 비활성화된 채라
       (capabilities.supportsFingerSnap=false) RECORD_AUDIO/FOREGROUND_SERVICE_MICROPHONE을 선언만
       해두고 안 쓰는 상태였음. Play Console 심사에서 민감 권한은 실사용을 소명해야 해서 반려 리스크만
       키움 — 매니페스트 선언 제거(감지기 코드 자체는 재활성화 대비 그대로 둠, PaceSnapDetector.kt 참고).
       재활성화 시 이 두 줄 + 아래 서비스 foregroundServiceType의 "microphone"만 되돌리면 됨. -->
  <!-- 2026-07-24 손 밀어내기(shoo) Hands-Free Next(PaceHandWaveDetector) — 앞카메라로 손 랜드마크만
       온디바이스로 추적, 영상/사진 저장이나 서버 전송 전혀 없음. Focus Session이 켜져 있는 동안만 연다. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
  <!-- 2026-07-25 BOOT_COMPLETED(B3) — 재부팅 시점에 이미 활성 중이던 세션(Daily Limit 카운트다운)을
       복구하기 위함. PaceBootReceiver.kt 상단 주석 참고 — "그날 세션을 한 번도 안 시작했으면 감지
       자체가 안 됨"이라는 더 넓은 문제는 이걸로 해결 안 됨(별도 설계 필요, PACE_PROJECT_MANAGEMENT.md
       §6 참고). -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- 2026-07-26 배터리 최적화 제외(사용자 지시, 외부 AI 조언 반영) — 삼성 One UI가 접근성/오버레이/
       사용정보 접근 권한을 배터리 최적화로 조용히 회수하는 걸 이번 세션 내내 겪어서, "배터리 사용량
       최적화 제외"를 사용자가 직접 설정할 수 있게 요청 다이얼로그로 안내한다. Play 정책상 이 권한은
       "핵심 기능에 반드시 필요한 경우"로 제한적으로만 승인되는데, Pace는 포그라운드 서비스가 실시간
       세션 집행(Daily Limit/Sleep Timer)을 담당하는 앱이라 해당 예외에 해당한다. -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

  <application>
    <service
      android:name="expo.modules.paceoverlay.PaceOverlayService"
      android:exported="false"
      android:foregroundServiceType="specialUse|camera">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Pace digital-wellbeing session overlay" />
    </service>

    <!-- 2026-07-19: 카운트다운 틱을 AlarmManager.setAndAllowWhileIdle()로 예약(PaceOverlayService.kt
         참고) — Doze 유지보수 윈도우에서도, 심지어 프로세스가 죽은 뒤에도 시스템이 이 리시버를 깨워
         PaceOverlayService(ACTION_TICK)를 재기동한다. exported=false — 우리 알람 PendingIntent만
         트리거해야 하므로 외부에서 브로드캐스트로 직접 호출 불가하게 막는다. -->
    <receiver
      android:name="expo.modules.paceoverlay.PaceTickReceiver"
      android:exported="false" />

    <!-- 2026-07-25 BOOT_COMPLETED(B3, PaceBootReceiver.kt 참고) — exported="true"는 시스템이 부팅
         브로드캐스트를 이 리시버에 배달하기 위한 필수 요건(자체적으로 protected broadcast라 임의
         3rd-party 앱이 스푸핑해 호출할 수 없음). RECEIVE_BOOT_COMPLETED 권한은 위에서 선언. -->
    <receiver
      android:name="expo.modules.paceoverlay.PaceBootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
      </intent-filter>
    </receiver>

    <!-- Auto Next 실제 스와이프(2026-07-18, PaceAccessibilityService.kt 주석 참고) — exported="true"는
         AccessibilityService의 필수 관례이고(시스템이 바인딩해야 함), android:permission이 시스템
         외 어떤 앱도 이 서비스에 바인딩할 수 없도록 실질적으로 보호한다. -->
    <service
      android:name="expo.modules.paceoverlay.PaceAccessibilityService"
      android:exported="true"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/accessibility_service_config" />
    </service>
  </application>
</manifest>
