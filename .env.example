# 커스텀 백엔드 (services/api/client.ts)
EXPO_PUBLIC_API_BASE_URL_DEV=http://localhost:8080
EXPO_PUBLIC_API_BASE_URL=

# iOS Pace Feed 콘텐츠 소스
# YouTube Data API v3 프록시 (services/api/youtube.ts + api/youtube-shorts.ts) — 프로덕션 기본
# 경로. 이 저장소를 Vercel 프로젝트로 연결한 뒤 배포 도메인을 넣는다(예: https://pace-app.vercel.app,
# 끝에 슬래시 없이). 진짜 YouTube API 키는 클라이언트가 아니라 Vercel 프로젝트 환경변수
# YOUTUBE_API_KEY(EXPO_PUBLIC_ 접두사 없음)에만 등록 — 앱 번들에 안 실려서 디컴파일로 못 뺌.
EXPO_PUBLIC_YOUTUBE_PROXY_URL=
# 로컬 개발 전용 폴백(__DEV__ 빌드에서만 사용, 위 프록시가 없을 때만) — 프로덕션 빌드에서는 절대
# 실제로 호출 안 됨(services/api/youtube.ts의 __DEV__ 분기 참고). 미설정 시 스크래핑 폴백.
EXPO_PUBLIC_YOUTUBE_API_KEY=
# Pexels Video API (services/api/pexels.ts) — 폴백/대체 소스(웰니스 클립). 미설정 시 DEV 샘플.
EXPO_PUBLIC_PEXELS_KEY=

# RevenueCat (store/useSubscriptionStore.ts)
EXPO_PUBLIC_RC_ANDROID_KEY=
EXPO_PUBLIC_RC_IOS_KEY=

# Google Sign-In (services/auth/google.ts) — Google Cloud Console OAuth 클라이언트 ID.
# webClientId는 Android/iOS 공통, iosClientId는 iOS 전용(없으면 iOS Google 로그인 자동 비활성화).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Android Auto Next — Play 스토어 심사 리스크로 기본 OFF. 직접 배포(APK) 빌드에서만 true.
# PACE_ARCHITECTURE.md "외부 리뷰 반영 2차" 참고.
EXPO_PUBLIC_ENABLE_AUTO_NEXT=false

# Pexels(services/... 큐레이션 영상/이미지 소스 — 실제 키는 로컬 .env에만)
EXPO_PUBLIC_PEXELS_API_KEY=
