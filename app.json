{
  "expo": {
    "name": "Pace",
    "slug": "Pace",
    "version": "1.0.1",
    "scheme": "pace",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.strides7.pace",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Pace listens for a finger snap (with echo cancellation of the video audio) to advance to the next Short hands-free.",
        "NSMotionUsageDescription": "Pace uses motion to detect when you place your phone face down, so it can measure your screen-free rest time (Flip Mode).",
        "NSSupportsLiveActivities": true
      },
      "icon": "./assets/ios-icon.png"
    },
    "android": {
      "package": "com.strides7.pace",
      "adaptiveIcon": {
        "backgroundColor": "#060709",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@bacons/apple-targets",
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#060709",
          "ios": {
            "image": "./assets/ios-splash-icon.png",
            "imageWidth": 220,
            "resizeMode": "contain",
            "backgroundColor": "#060709"
          },
          "android": {
            "image": "./assets/android-icon-foreground.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#060709"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-localization",
      "expo-font",
      "expo-video",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "expo-sharing",
      "expo-updates",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "6d080d0f-1fc1-4241-a4ca-97c5c79d8656"
      }
    },
    "owner": "strides7",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6d080d0f-1fc1-4241-a4ca-97c5c79d8656",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    }
  }
}
