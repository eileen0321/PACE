# 로컬 개발/Railway 배포 공통 환경변수 템플릿. 실제 .env는 git에 커밋하지 않는다(.gitignore 처리됨).

# --- DB (로컬은 docker-compose.yml 기본값과 이미 일치 — application-dev.yml 참고) ---
DB_URL=jdbc:mysql://localhost:3306/pace?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=pace
DB_PASSWORD=pace

# --- JWT (필수 — 미설정 시 기동 자체가 실패하도록 JwtProvider가 fail-fast 처리) ---
# 최소 32바이트(256비트) 이상. 예: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=2592000000

# --- Google idToken 검증 ---
GOOGLE_CLIENT_ID=

# --- Apple identityToken 검증 ---
APPLE_BUNDLE_ID=com.strides7.pace

# --- RevenueCat ---
REVENUECAT_WEBHOOK_AUTH_HEADER=
REVENUECAT_API_KEY=

# --- 기타 ---
CORS_ORIGINS=*
PORT=8080
SPRING_PROFILES_ACTIVE=dev
