<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- 이 모듈의 매니페스트는 Gradle 매니페스트 병합으로 앱 최종 AndroidManifest.xml에 자동 합쳐진다
       (Expo Modules API 로컬 모듈 컨벤션) — 별도 config plugin으로 권한을 추가할 필요 없음. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- PaceTickReceiver가 Doze 중 알람 처리 동안 짧게(최대 10초) CPU를 붙잡아두는 데 필요 -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- 포그라운드 앱 감지(ForegroundAppWatcher, UsageStatsManager)용 — 런타임 권한이 아니라
       설정 > 특별 앱 액세스 > 사용정보 접근에서 사용자가 직접 승인해야 하는 특수 권한 -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
  <!-- 2026-07-29 사장님 결정 — 핑거스냅(PaceSnapDetector)이 iOS/Android 둘 다 완전히 비활성화된 채라
       (capabilities.supportsFingerSnap=false) RECORD_AUDIO/FOREGROUND_SERVICE_MICROPHONE을 선언만
       해두고 안 쓰는 상태였음. Play Console 심사에서 민감 권한은 실사용을 소명해야 해서 반려 리스크만
       키움 — 매니페스트 선언 제거(감지기 코드 자체는 재활성화 대비 그대로 둠, PaceSnapDetector.kt 참고).
       재활성화 시 이 두 줄 + 아래 서비스 foregroundServiceType의 "microphone"만 되돌리면 됨. -->
  <!-- 2026-07-24 손 밀어내기(shoo) Hands-Free Next(PaceHandWaveDetector) — 앞카메라로 손 랜드마크만
       온디바이스로 추적, 영상/사진 저장이나 서버 전송 전혀 없음. Focus Session이 켜져 있는 동안만 연다. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
  <!-- 2026-07-25 BOOT_COMPLETED(B3) — 재부팅 시점에 이미 활성 중이던 세션(Daily Limit 카운트다운)을
       복구하기 위함. PaceBootReceiver.kt 상단 주석 참고 — "그날 세션을 한 번도 안 시작했으면 감지
       자체가 안 됨"이라는 더 넓은 문제는 이걸로 해결 안 됨(별도 설계 필요, PACE_PROJECT_MANAGEMENT.md
       §6 참고). -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- 2026-07-26 배터리 최적화 제외(사용자 지시, 외부 AI 조언 반영) — 삼성 One UI가 접근성/오버레이/
       사용정보 접근 권한을 배터리 최적화로 조용히 회수하는 걸 이번 세션 내내 겪어서, "배터리 사용량
       최적화 제외"를 사용자가 직접 설정할 수 있게 요청 다이얼로그로 안내한다. Play 정책상 이 권한은
       "핵심 기능에 반드시 필요한 경우"로 제한적으로만 승인되는데, Pace는 포그라운드 서비스가 실시간
       세션 집행(Daily Limit/Sleep Timer)을 담당하는 앱이라 해당 예외에 해당한다. -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

  <!-- 2026-08-09 — 우리가 직접 그리는 공유 시트(PaceOverlayService.showShareSheet)가 공유 가능한 앱
       목록을 만들려면 queryIntentActivities()가 필요하다. Android 11(API 30)부터는 패키지 가시성
       제한 때문에 **이 선언이 없으면 결과가 빈 목록으로 돌아온다**(권한 오류도 안 나서 조용히 망가진다).
       범위는 딱 필요한 만큼만 — "text/plain을 ACTION_SEND로 받는 앱"으로 한정한다. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.SEND" />
      <data android:mimeType="text/plain" />
    </intent>
  </queries>

  <application>
    <service
      android:name="expo.modules.paceoverlay.PaceOverlayService"
      android:exported="false"
      android:foregroundServiceType="specialUse|camera">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Pace digital-wellbeing session overlay" />
    </service>

    <!-- 2026-07-19: 카운트다운 틱을 AlarmManager.setAndAllowWhileIdle()로 예약(PaceOverlayService.kt
         참고) — Doze 유지보수 윈도우에서도, 심지어 프로세스가 죽은 뒤에도 시스템이 이 리시버를 깨워
         PaceOverlayService(ACTION_TICK)를 재기동한다. exported=false — 우리 알람 PendingIntent만
         트리거해야 하므로 외부에서 브로드캐스트로 직접 호출 불가하게 막는다. -->
    <receiver
      android:name="expo.modules.paceoverlay.PaceTickReceiver"
      android:exported="false" />

    <!-- 2026-07-25 BOOT_COMPLETED(B3, PaceBootReceiver.kt 참고) — exported="true"는 시스템이 부팅
         브로드캐스트를 이 리시버에 배달하기 위한 필수 요건(자체적으로 protected broadcast라 임의
         3rd-party 앱이 스푸핑해 호출할 수 없음). RECEIVE_BOOT_COMPLETED 권한은 위에서 선언. -->
    <receiver
      android:name="expo.modules.paceoverlay.PaceBootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
      </intent-filter>
      <!-- 2026-08-03 — 플레이스토어 업데이트도 재부팅과 똑같이 프로세스와 포그라운드 서비스를 죽인다.
           세션 중에 업데이트되면 알약이 조용히 사라지고 세션만 prefs에 활성으로 남는다(PaceBootReceiver.kt
           상단 주석 참고). 재부팅과 성격이 동일하므로 같은 복구 루트를 태운다. MY_PACKAGE_REPLACED는
           우리 앱에만 배달되는 브로드캐스트라 data 스킴 필터가 필요 없다(PACKAGE_REPLACED와 다름). -->
      <intent-filter>
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <!-- Auto Next 실제 스와이프(2026-07-18, PaceAccessibilityService.kt 주석 참고) — exported="true"는
         AccessibilityService의 필수 관례이고(시스템이 바인딩해야 함), android:permission이 시스템
         외 어떤 앱도 이 서비스에 바인딩할 수 없도록 실질적으로 보호한다. -->
    <service
      android:name="expo.modules.paceoverlay.PaceAccessibilityService"
      android:exported="true"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/accessibility_service_config" />
    </service>

    <!-- 2026-08-01 발견 — PaceShareCaptureActivity.kt는 시스템 공유시트로 유튜브 영상 URL을 가로채는
         핵심 메커니즘인데(PaceAccessibilityService.captureCurrentVideoInfoInternal 참고) 이 activity
         선언 자체가 매니페스트에 빠져 있었다. 선언이 없으면 공유시트에 "Pace"가 아예 뜰 수 없어서
         PaceAccessibilityService의 자동 클릭 폴링이 못 찾고 타임아웃까지 계속 돌고, 사용자 눈엔
         "Add current video"를 눌렀는데 공유시트만 뜬 채 멈춰있는 것으로 보였다(실기기 재현 확인).
         exported=true + SEND/text-plain 인텐트필터로 시스템 공유시트 대상에 등록. android:label을
         "Pace"로 고정 — pollForShareTarget이 findNodeByExactText(root, "Pace")로 정확히 이 문자열을
         찾는다(앱 표시 이름이 나중에 바뀌어도 이 라벨은 그대로 유지해야 함). Translucent 테마 +
         noHistory + excludeFromRecents로 화면 깜빡임/최근앱 잔류 없이 즉시 처리 후 사라진다.

         🔴 2026-08-09 사장님 지적 — "맥은 쇼츠 보다 즐겨찾기 추가하고 계속 쇼츠를 보는데
         왜 (안드로이드는) 홈 갔다 다시 쇼츠로 와?"
         원인은 **taskAffinity가 없어서 이 액티비티가 Pace 앱의 기존 태스크(MainActivity=홈이 들어있는)에
         붙는 것**이었다. 그 태스크가 통째로 앞으로 나오니 투명 배경 뒤로 Pace 홈이 드러나고, 끝난 뒤
         유튜브로 되돌리느라 "홈 → 쇼츠" 왕복이 눈에 보였다.
         PaceOverlayService.addRow의 onReturnRequested 주석이 이미 증상을 정확히 적어놨는데
         ("PaceShareCaptureActivity가 사라지면서 같은 태스크의 MainActivity가 드러난다") 처치는 700ms
         지연이라는 대증요법이었다. 보상형 광고(PaceRewardedAdActivity)는 같은 문제를 이미
         taskAffinity=""로 해결해뒀다 — 같은 처치를 여기에도 적용한다.
         ⚠️ 이 액티비티는 다른 앱의 공유시트에도 뜨는 대상이라 그 경로에도 함께 적용된다.
           noHistory/excludeFromRecents가 이미 붙어 있어 자기 태스크로 떠도 잔류 문제는 없다. -->
    <activity
      android:name="expo.modules.paceoverlay.PaceShareCaptureActivity"
      android:exported="true"
      android:label="Pace"
      android:theme="@style/Theme.Pace.TransparentShell"
      android:noHistory="true"
      android:excludeFromRecents="true"
      android:taskAffinity="">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>

    <!-- 2026-08-02 — FOCUS OFF 배지를 눌렀을 때 "앱으로 가지 않고" 쇼츠 위에 보상형 광고만 띄우기
         위한 투명 껍데기 액티비티(PaceRewardedAdActivity.kt 참고 — 광고 SDK는 Activity 컨텍스트가
         있어야만 전면 광고를 띄울 수 있어서 Service/오버레이 창에서는 불가능하다).
         원래 android/app/src/main/AndroidManifest.xml에 있었는데 그쪽은 prebuild가 재생성하며 날리는
         파일이라 모듈로 옮겼다(res/values/styles.xml의 같은 취지 주석 참고 — 중복 선언 시 매니페스트
         병합이 테마 속성 충돌로 실패하므로 앱 매니페스트 쪽 선언은 제거했다).
         taskAffinity="" — 이게 없으면 안드로이드가 이 액티비티를 Pace 앱의 기존 태스크(홈 화면이
         들어있는)에 붙여버려, 투명 배경 뒤로 Pace 홈이 그대로 비친다("왜 앱 홈으로 가냐"의 정체). -->
    <activity
      android:name="expo.modules.paceoverlay.PaceRewardedAdActivity"
      android:exported="false"
      android:theme="@style/Theme.Pace.TransparentAd"
      android:noHistory="true"
      android:excludeFromRecents="true"
      android:taskAffinity="" />

    <!-- 2026-08-09 — 즐겨찾기 공유창의 미리보기(제목+썸네일)를 우리가 직접 넘겨주기 위한 provider.
         이게 없으면 시스템 공유창이 유튜브 페이지를 **스스로 받아와** 제목/og:image를 채우는데,
         실기기 실측으로 생 URL만 보이다가 채워지기까지 약 3초가 걸렸다(1.3초 → 4.1초).
         우리는 이미 같은 썸네일을 cacheDir/pace-thumbs에 캐시해두므로 네트워크 없이 즉시 줄 수 있다.
         exported="false" + grantUriPermissions — 공유창/수신 앱에는 FLAG_GRANT_READ_URI_PERMISSION으로
         그 URI 하나만 일시 허용된다(앱 내부 파일이 열리는 게 아니다).
         ⚠️ 다른 라이브러리(RNCWebView/expo-file-system/expo-sharing)도 각자 FileProvider를 갖고 있지만
           경로 설정이 cacheDir/pace-thumbs를 포함하지 않아 재사용할 수 없다 — 그래서 별도로 둔다. -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.paceThumbProvider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/pace_thumb_paths" />
    </provider>

    <!-- 2026-08-22 — 구글 로그인 트램폴린 두 개. play-services-auth / play-services-base가 자기 AAR
         매니페스트에서 @android:style/Theme.Translucent.NoTitleBar로 선언하고, 그게 우리 앱
         매니페스트에 병합된다. 그 테마는 시스템 바 색을 지정하지 않아 OEM 기본값(삼성 One UI에서는
         흰 내비게이션 키)이 그대로 노출되는데, 이건 옆 styles.xml에 이미 두 번 기록된 함정이다
         (PaceRewardedAdActivity 2026-08-02, PaceShareCaptureActivity 2026-08-05).
         → 같은 처치(Theme.Pace.TransparentShell)를 예방적으로 적용해둔다. 투명도는 유지되므로
           트램폴린 동작은 변하지 않는다.

         ⚠️⚠️ **이 수정은 사장님이 보고하신 "로그인 누르면 하단이 흰키"를 고치지 못했다.**
           실기기(SM-N986N, 라이트 모드)에서 수정 전/후 프레임을 10fps로 비교했는데 흰색 구간
           길이가 그대로였고, 그 구간의 topResumedActivity를 조밀하게 폴링한 결과:
             com.google.android.gms/.signin.activity.SignInActivity          ← 흰색
             com.google.android.gms/.common.account.AccountPickerActivity    ← 회색
           **둘 다 GMS 패키지 소유**다. 여기서 테마를 씌운 SignInHubActivity/GoogleApiActivity는
           그 흐름에서 아예 최상단에 뜨지 않는다(폴링에 한 번도 안 잡힘).
           → 남의 패키지 액티비티라 앱에서 테마를 못 씌운다. 기기 시스템 다크모드를 켜면 둘 다
             다크로 나오는 것으로 원인 확정(라이트 모드 폰이면 흰 시트/회색 바가 정상 동작).
           **다시 이 각도로 시도하지 말 것.** 유일하게 안 해본 경로는 라이브러리의
           "Universal sign in"(Credential Manager) 마이그레이션인데, 그 시트도 시스템 UI라
           같을 가능성이 높고 검증 안 됐다. -->
    <activity
      android:name="com.google.android.gms.auth.api.signin.internal.SignInHubActivity"
      android:theme="@style/Theme.Pace.TransparentShell"
      tools:replace="android:theme" />
    <activity
      android:name="com.google.android.gms.common.api.GoogleApiActivity"
      android:theme="@style/Theme.Pace.TransparentShell"
      tools:replace="android:theme" />
  </application>
</manifest>
