<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <!-- 2026-08-02 출시 전 감사 — 저장소 권한 제거. 앱/모듈 코드 전체에 사용처가 0건이고
       (expo-media-library·image-picker 미사용, MediaStore/getExternalStorage 호출 없음),
       expo-file-system이 자기 매니페스트에서 자동으로 넣던 것이 병합돼 올라오고 있었다.
       Play Console은 업로드 시 민감 권한의 사용 사유를 요구하는데 정당화할 근거가 없고,
       권한 목록에 뜨는 것만으로 설치 전환율에도 불리하다. maxSdkVersion=32로 제한돼 있어
       실질 위험은 낮았지만 "쓰지 않는 권한은 선언하지 않는다"가 원칙이라 병합 단계에서 제거한다.
       expo-file-system이 실제로 외부 저장소를 쓰게 되면 이 두 줄을 지워 되살릴 것. -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false">
    <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="ca-app-pub-3201481146134957~4795871538" tools:replace="android:value"/>
    <meta-data android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING" android:value="true" tools:replace="android:value"/>
    <meta-data android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION" android:value="true" tools:replace="android:value"/>
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="true"/>
    <meta-data android:name="expo.modules.updates.ENABLE_BSDIFF_PATCH_SUPPORT" android:value="true"/>
    <meta-data android:name="expo.modules.updates.EXPO_RUNTIME_VERSION" android:value="@string/expo_runtime_version"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="NEVER"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATE_URL" android:value="https://u.expo.dev/6d080d0f-1fc1-4241-a4ca-97c5c79d8656"/>
    <meta-data android:name="expo.modules.updates.UPDATES_CONFIGURATION_REQUEST_HEADERS_KEY" android:value="{&quot;expo-channel-name&quot;:&quot;production&quot;}"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|assetsPaths|locale|layoutDirection" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="pace"/>
      </intent-filter>
    </activity>
    <!-- 2026-07-29 실기기 발견("보상광고 뜰 때 하단키가 흰색") — Google Mobile Ads SDK가 전면(보상형/
         전면) 광고를 자체 AdActivity(별도 Activity, play-services-ads AAR 안에 있어 우리 코드에서
         안 보임)로 띄우는데, 이 액티비티는 우리 AppTheme(systemBarColor 통일)을 안 물려받고 SDK
         기본 테마(라이트/화이트 시스템 바)를 쓴다. tools:replace로 우리 테마를 강제 지정해 광고
         화면에서도 상태바/내비바 색이 앱과 통일되게 한다. -->
    <activity android:name="com.google.android.gms.ads.AdActivity" android:theme="@style/AppTheme" tools:replace="android:theme" android:exported="false"/>
    <!-- 2026-07-31 사장님 지시(오버레이 Favorite/Capture) — 유튜브 Shorts는 URL 주소창이 없는 몰입형
         플레이어라 접근성 트리만으로는 실제 영상 링크(videoId)를 못 읽는다. 표준 해법: 우리 앱을
         ACTION_SEND(text/plain) 대상으로 등록해두고, 접근성 서비스가 유튜브의 "동영상 공유" 버튼을
         눌러 시스템 공유시트를 띄운 뒤 그 목록에서 "Pace"를 찾아 클릭하면, 안드로이드가 실제 공유
         텍스트(영상 URL 포함)를 이 액티비티로 그대로 전달한다 — 유튜브 UI 내부 구조가 버전마다
         바뀌어도 깨지지 않는 공식 Intent 계약에 기반한 방법(PaceShareCaptureActivity.kt 참고).
         투명 테마 + noHistory로 화면 깜빡임 없이 즉시 처리 후 사라진다. -->
    <activity
      android:name="expo.modules.paceoverlay.PaceShareCaptureActivity"
      android:theme="@android:style/Theme.Translucent.NoTitleBar"
      android:noHistory="true"
      android:excludeFromRecents="true"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.SEND"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <data android:mimeType="text/plain"/>
      </intent-filter>
    </activity>
    <!-- 2026-08-02 사장님 지시("쇼츠 오버레이 상태 focus off일 때 누르면 광고 창 띄우는 걸로 해,
         앱으로 가는 시나리오 만들지 말고") — 보상형 광고는 SDK 특성상 Activity가 있어야만 띄울 수
         있어(Service/오버레이 창에서 직접 불가), 화면을 그리지 않는 투명 껍데기 액티비티를 두고
         그 위에 광고만 띄운다. 광고가 닫히면 즉시 finish → 사용자는 "쇼츠 위에 광고가 떴다 사라짐"
         으로만 느끼고 Pace 앱 화면은 보이지 않는다(PaceRewardedAdActivity.kt 참고). -->
    <activity
      android:name="expo.modules.paceoverlay.PaceRewardedAdActivity"
      android:theme="@android:style/Theme.Translucent.NoTitleBar"
      android:noHistory="true"
      android:excludeFromRecents="true"
      android:exported="false"/>
  </application>
</manifest>