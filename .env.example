# 커스텀 백엔드 (services/api/client.ts)
EXPO_PUBLIC_API_BASE_URL_DEV=http://localhost:8080
EXPO_PUBLIC_API_BASE_URL=

# RevenueCat (store/useSubscriptionStore.ts)
EXPO_PUBLIC_RC_ANDROID_KEY=
EXPO_PUBLIC_RC_IOS_KEY=

# Google Sign-In (services/auth/google.ts) — Google Cloud Console OAuth 클라이언트 ID.
# webClientId는 Android/iOS 공통, iosClientId는 iOS 전용(없으면 iOS Google 로그인 자동 비활성화).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Android Auto Next — Play 스토어 심사 리스크로 기본 OFF. 직접 배포(APK) 빌드에서만 true.
# PACE_ARCHITECTURE.md "외부 리뷰 반영 2차" 참고.
EXPO_PUBLIC_ENABLE_AUTO_NEXT=false
