# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (실제 키가 들어가는 파일 전부 무시 — .env.example만 커밋)
.env*.local
.env
.env.*
.env_*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local Expo module build artifacts (source under modules/*/android is tracked, build output isn't)
modules/**/android/build/
modules/**/android/.gradle/
modules/**/android/.cxx/

# tool-local state, not project source
.claude/
